# .env.example
# 复制此文件为 .env 并填入实际配置

# 内置 SQLite 数据库
DATABASE_URL=file:/work/data/embed.db?_journal_mode=WAL&_busy_timeout=5000

# GDStudio API
GD_API_BASE=https://music-api.gdstudio.xyz

# Navidrome
NAVIDROME_BASE_URL=http://localhost:4533
NAVIDROME_USER=admin
NAVIDROME_PASSWORD=admin
# 或使用 Token/Salt 认证
# NAVIDROME_TOKEN=your-token-here
# NAVIDROME_SALT=your-salt-here

# Worker 配置
MAX_CONCURRENT_JOBS=3
JOB_POLL_INTERVAL=2s
DOWNLOAD_TIMEOUT=600s
LOG_LEVEL=info

# 安全配置
API_KEY=your-secure-api-key-here
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# 存储路径
# Docker 部署时请把宿主机音乐目录写到 NAVIDROME_MUSIC_DIR，
# compose 会把它按相同绝对路径挂载进容器，并覆盖 storage.music_dir。
WORK_DIR=/work/tmp
NAVIDROME_MUSIC_DIR=/path/to/navidrome/music
